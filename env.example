RESEND_API_KEY=re_123456789
# Server-side key for the live demo (/api/demo). Never exposed to the client.
ANTHROPIC_API_KEY=sk-ant-xxxxxxxx
# Optional: override the demo model (default: claude-haiku-4-5 — fast and cheap
# for a public demo). If replies feel weak in Albanian, set claude-sonnet-5.
# Do not use Opus for the demo.
DEMO_MODEL=claude-haiku-4-5

# Comma-separated allow-list of origins permitted to POST to the API routes
# (contact, audit, demo). Leave UNSET in local dev to allow all origins.
# In production set to the deployed origin(s), e.g.:
# ALLOWED_ORIGINS=https://codrix.al,https://www.codrix.al
ALLOWED_ORIGINS=

# Upstash Redis — persistent rate limiting + demo session turn counts.
# Provision from the Vercel Marketplace (Upstash) or upstash.com. If unset,
# the limiters fail open (dev-friendly); the provider spend cap is the backstop.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
